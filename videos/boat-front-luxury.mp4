name: Auto Video All Accounts V8 Fixed - No Dhemaji - krr908

on:
  schedule:
    - cron: '30 3 * * *'
    - cron: '30 9 * * *'
    - cron: '0 15 * * *'
  workflow_dispatch:
    inputs:
      platform:
        description: 'Platform - all/youtube/facebook/instagram'
        required: false
        default: 'all'
      video_file:
        description: 'Video file name from videos folder - e.g. boat.mp4'
        required: false
        default: ''

jobs:
